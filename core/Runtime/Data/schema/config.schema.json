{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/La-Cizaille/vortex/core/Runtime/Data/schema/config.schema.json",
  "title": "Vortex — configuration des règles de base",
  "description": "Valeurs d'équilibrage des règles de base (valeurs ⚙ de RULES.md). Aide à l'édition uniquement : GameConfig.Validate fait foi.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "startingHp", "maxHp", "minShield", "maxShield", "dieFaces", "marketSize", "maxOvercharge",
    "criticalBonusWithoutModifier", "tormentValue", "eventFrequency", "doomEventId", "playerCounts",
    "reactionDepthLimit", "maxDecisionsPerCommand"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "startingHp": { "type": "integer", "minimum": 1, "maximum": 999, "description": "PV de départ (RULES A3)." },
    "maxHp": { "type": "integer", "minimum": 1, "maximum": 999, "description": "PV maximum (soins plafonnés)." },
    "minShield": { "type": "integer", "minimum": 0, "description": "Borne basse du bouclier." },
    "maxShield": { "type": "integer", "minimum": 1, "maximum": 99, "description": "Borne haute du bouclier." },
    "dieFaces": { "type": "integer", "minimum": 2, "maximum": 100, "description": "Faces du dé ; la face max est le critique." },
    "marketSize": { "type": "integer", "minimum": 1, "maximum": 20, "description": "Cartes visibles par marché noir." },
    "maxOvercharge": { "type": "integer", "minimum": 1, "maximum": 10, "description": "Jetons de surcharge maximum." },
    "criticalBonusWithoutModifier": { "type": "integer", "minimum": 0, "maximum": 99, "description": "Dégâts en plus d'un critique contre un vaisseau sans modificateur." },
    "tormentValue": { "type": "integer", "minimum": 0, "maximum": 99, "description": "PV perdus par jeton de Tourment." },
    "eventFrequency": { "type": "integer", "minimum": 0, "maximum": 99, "description": "Un événement toutes les N manches ; 0 désactive les événements." },
    "doomEventId": { "type": "string", "pattern": "^EVT_[A-Z0-9_]+$", "description": "Événement hors paquet, révélé à la manche doomRound." },
    "playerCounts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["players", "startShield", "doomRound"],
        "properties": {
          "players": { "type": "integer", "minimum": 2, "maximum": 8 },
          "startShield": { "type": "integer", "minimum": 0, "maximum": 99, "description": "StartShield[n]." },
          "doomRound": { "type": "integer", "minimum": 1, "maximum": 999, "description": "DoomRound[n]." }
        }
      }
    },
    "reactionDepthLimit": { "type": "integer", "minimum": 4, "maximum": 64, "description": "Garde-fou technique (RULES B7)." },
    "maxDecisionsPerCommand": { "type": "integer", "minimum": 8, "maximum": 512, "description": "Garde-fou technique (ADR-0009)." }
  }
}
