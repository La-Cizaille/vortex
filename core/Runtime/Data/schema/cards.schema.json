{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/La-Cizaille/vortex/core/Runtime/Data/schema/cards.schema.json",
  "title": "Vortex — modificateurs",
  "description": "Source de vérité des cartes modificateurs (ADR-0008). Aide à l'édition uniquement : le validateur C# (GameDataValidator) fait foi.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cards"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 3
    },
    "cards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/card"
      }
    }
  },
  "$defs": {
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "slot",
        "color",
        "usage",
        "copies",
        "needsReview",
        "text",
        "ruling",
        "effects"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(A|D)_[0-9]{3}$",
          "description": "A_xxx pour une carte d'attaque, D_xxx pour une carte de défense. Stable : ne jamais réutiliser un id retiré."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "slot": {
          "enum": [
            "Attack",
            "Defense"
          ],
          "description": "Emplacement sur le vaisseau et marché d'origine."
        },
        "color": {
          "enum": [
            "Neutral",
            "Blue",
            "Red",
            "Green",
            "Yellow"
          ],
          "description": "Technologie. Neutral ne forme jamais de combo."
        },
        "usage": {
          "enum": [
            "Durable",
            "SingleUse",
            "Triggered"
          ]
        },
        "copies": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "needsReview": {
          "type": "boolean",
          "description": "Carte à retravailler par le game designer."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "description": "Texte imprimé. Icônes : <ATQ> <BOU> <MOD> <TOR> <SUR> <MKT> <DIC>. **gras** autorisé."
        },
        "flavor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^<>]*$",
          "description": "Texte d'ambiance facultatif, sous le texte de règle (ARB-95). Texte brut, sans balise ; n'énonce jamais une règle."
        },
        "ruling": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "Interprétation exacte selon le modèle d'effets (RULES.md partie B). Ne cite jamais une autre carte."
        },
        "effects": {
          "type": "array",
          "description": "Briques d'effets (ADR-0007). Catalogue et paramètres : docs/BRICKS.md.",
          "items": {
            "type": "object",
            "required": [
              "brick"
            ],
            "properties": {
              "brick": {
                "enum": [
                  "AttackValueBonus",
                  "ParityAttackBonus",
                  "IgnoreTargetShield",
                  "AttackAdvantage",
                  "IncomingAttackDisadvantage",
                  "HealOnHit",
                  "StealShieldBeforeAttack",
                  "DieBetMultiplier",
                  "RerollShieldOnHit",
                  "DiscardTargetModifierOnHit",
                  "TormentTargetOnAttack",
                  "TormentMarketOnHit",
                  "ScorchedEarthOnKill",
                  "DenyShieldChangeByOpponents",
                  "CapIncomingAttackLoss",
                  "PreventNextAttackLoss",
                  "PreventFatalAttackLoss",
                  "BlockAttackerNextTurn",
                  "CapEnemyShield",
                  "DictateAttackerAction",
                  "HealWhenOthersDamaged",
                  "ReflectAttackLoss",
                  "HealOnOwnTormentLoss",
                  "TormentAttackerOnLoss",
                  "GambleOnHpLoss",
                  "CopyHighestShieldOnTurnStart",
                  "HpBalanceOnTurnStart",
                  "ShieldChangeOnTurnStart",
                  "PreRollDie",
                  "DisableShields",
                  "ExtraMarketPicks",
                  "DisableOpponentShieldThisTurn",
                  "ConvertShieldToNextAttack",
                  "NextAttackDamageMultiplier",
                  "NextAttackBonusPerNeutral",
                  "NextAttackOvercharged",
                  "AllInAttack",
                  "SwapOnNextAttack",
                  "DiscardOpponentModifiers",
                  "StealOpponentModifiers",
                  "StealOrDestroyOpponentModifier",
                  "RefreshMarketAndPick",
                  "RefreshAllMarkets",
                  "TormentOpponentAndNeighbours",
                  "ReactivateTorments",
                  "ClearAllTormentsHealPer",
                  "TormentAllEquipped",
                  "ClearPlayerTorments",
                  "TormentValueBonus",
                  "ConvertHpToShield",
                  "SwapTwoShields",
                  "SetOwnShield",
                  "SetAllShields",
                  "DisableOwnShieldUntilNextTurn",
                  "RotateShields",
                  "Heal",
                  "HealPerNeutral",
                  "GainOvercharge",
                  "KeepOverchargeUntilNextTurn",
                  "NextOverchargedAttackAdvantage",
                  "DiscardAllEquippedModifiers",
                  "RedirectAttacksUntilNextTurn",
                  "ExtraCrewActionsThisTurn"
                ],
                "description": "Nom de la brique."
              }
            },
            "additionalProperties": {
              "type": [
                "integer",
                "boolean",
                "string"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "slot": {
                "const": "Attack"
              }
            }
          },
          "then": {
            "properties": {
              "id": {
                "pattern": "^A_[0-9]{3}$"
              }
            }
          },
          "else": {
            "properties": {
              "id": {
                "pattern": "^D_[0-9]{3}$"
              }
            }
          }
        }
      ]
    }
  }
}
