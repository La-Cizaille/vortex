<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compiles the shared rules engine sources from /core/Runtime (ADR-0002).
    Target and language version mirror what Unity 6 supports, so anything that
    builds here also builds in Unity.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>Vortex.Core</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\core\Runtime\**\*.cs" LinkBase="Runtime" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vortex.Core.Tests" />
    <!-- The content tool documents the (internal) brick catalog. -->
    <InternalsVisibleTo Include="Vortex.ContentTool" />
  </ItemGroup>
</Project>
