<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Developer tool for the content files in core/Runtime/Data (ADR-0008):
      validate : load all files through the same hardened loader as the game
      format   : rewrite files in canonical form (check-only mode in CI)
      docs     : generate docs/CARDS.md (check-only mode in CI)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Vortex.ContentTool</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vortex.Core\Vortex.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vortex.Core.Tests" />
  </ItemGroup>
</Project>
