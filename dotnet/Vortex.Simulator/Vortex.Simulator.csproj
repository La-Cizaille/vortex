<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Balance simulator (milestone M3, ADR-0010): plays many bot games with the real content and writes a
    markdown report (game length, seat advantage, skill gap, card and event statistics).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Vortex.Simulator</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vortex.Core\Vortex.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vortex.Core.Tests" />
  </ItemGroup>
</Project>
