# ---------------------------------------------------------------
# Secrets — never committed (see docs/SECURITY.md)
# ---------------------------------------------------------------
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
.env
.env.*
secrets.*

# ---------------------------------------------------------------
# Art sources: .blend files are versioned with Git LFS (ADR-0016);
# Blender's backup copies (.blend1, .blend2...) are not.
# ---------------------------------------------------------------
*.blend[0-9]

# ---------------------------------------------------------------
# OS / editors
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
~$*

# Git LFS writes its hooks here when core.hooksPath is /dev/null (AI sessions): never commit them.
/dev/null/
